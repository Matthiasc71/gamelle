  "etapes": [
    {
      "texte": "Mélange le yaourt et les épices, enrobes-en le poulet coupé en morceaux et laisse mariner 30 minutes au frais.",
      "duree_min": 5,
      "actif": true
    },
    {
      "texte": "Pendant ce temps, hache les noix de cajou, émince les oignons et l'ail, râpe le gingembre.",
      "duree_min": 8,
      "actif": true
    },
    {
      "texte": "Dans une sauteuse, dore les oignons, puis ajoute ail, gingembre et concentré 1 minute. Ajoute le poulet et sa marinade et fais-le dorer.",
      "duree_min": 8,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 480
    },
    {
      "texte": "Verse les tomates et le lait de coco, porte à ébullition puis couvre et laisse mijoter 20 minutes en remuant souvent.",
      "duree_min": 20,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 1200
    },
    {
      "texte": "Parsème de noix de cajou au moment de servir.",
      "duree_min": 1,
      "actif": true
    }
