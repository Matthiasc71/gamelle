  "etapes": [
    {
      "texte": "Coupe le poulet en petits morceaux et fais-le dorer 2 à 3 minutes par face dans une poêle huilée. Réserve.",
      "duree_min": 6,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 300
    },
    {
      "texte": "Pendant ce temps, émince l'échalote et le blanc des poireaux, et rince-les bien.",
      "duree_min": 6,
      "actif": true
    },
    {
      "texte": "Dans une cocotte huilée, fais revenir l'échalote 2 minutes, ajoute les coquillettes et laisse-les dorer 2 minutes en remuant. Verse le vin blanc si tu en mets et laisse absorber.",
      "duree_min": 5,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 240
    },
    {
      "texte": "Ajoute les poireaux et le bouillon (environ 75 cl d'eau) petit à petit, en attendant qu'il soit absorbé, jusqu'à ce que les pâtes soient cuites.",
      "duree_min": 14,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 840
    },
    {
      "texte": "Ajoute le poulet 2 minutes, puis hors du feu le chèvre frais. Mélange jusqu'à ce qu'il fonde, sale et poivre.",
      "duree_min": 3,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 120
    }
