  "etapes": [
    {
      "texte": "Épluche et émince les oignons et l'ail. Épluche les légumes : carottes en rondelles, courge et navets en cubes, brocoli en petits bouquets.",
      "duree_min": 15,
      "actif": true
    },
    {
      "texte": "Dans une cocotte, fais revenir oignons et ail 2 minutes dans l'huile, puis ajoute curry, curcuma, sel et poivre.",
      "duree_min": 3,
      "actif": true,
      "equipement": "plaques"
    },
    {
      "texte": "Ajoute tous les légumes et laisse-les prendre couleur 2 minutes en remuant.",
      "duree_min": 2,
      "actif": true,
      "equipement": "plaques"
    },
    {
      "texte": "Verse les pois chiches égouttés, les lentilles corail, le lait de coco et 20 cl d'eau. Couvre et laisse mijoter 20 minutes.",
      "duree_min": 20,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 1200
    },
    {
      "texte": "Pendant la cuisson, prépare le boulgour comme indiqué sur le paquet sur le second feu.",
      "duree_min": 12,
      "actif": false,
      "equipement": "plaques"
    },
    {
      "texte": "Répartis le curry et le boulgour dans 4 boîtes.",
      "duree_min": 3,
      "actif": true
    }
  ],
