  "etapes": [
    {
      "texte": "Préchauffe le four à 180 °C. Retire le pied et le cœur des endives et cuis-les 20 minutes à l'eau frémissante : elles doivent rester un peu fermes. Égoutte-les bien.",
      "duree_min": 20,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 1200
    },
    {
      "texte": "Béchamel : fais fondre le beurre, ajoute la farine et remue 1 minute, puis verse le lait en fouettant jusqu'à ce que ça épaississe. Sale, poivre, ajoute un peu de muscade si tu en as.",
      "duree_min": 7,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 420
    },
    {
      "texte": "Verse un tiers de la béchamel dans le plat, roule chaque endive dans une tranche de jambon et range-les dessus. Couvre du reste de sauce et du fromage.",
      "duree_min": 5,
      "actif": true
    },
    {
      "texte": "Enfourne 20 minutes.",
      "duree_min": 20,
      "actif": false,
      "equipement": "four",
      "minuteur_s": 1200
    }
