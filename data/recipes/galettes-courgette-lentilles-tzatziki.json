  "etapes": [
    {
      "texte": "Cuis les lentilles 10 minutes dans un grand volume d'eau non salée, égoutte et laisse refroidir.",
      "duree_min": 10,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 600
    },
    {
      "texte": "Pendant ce temps, râpe la courgette et le concombre, cisèle l'oignon et la menthe, presse l'ail.",
      "duree_min": 8,
      "actif": true
    },
    {
      "texte": "Mélange courgette, lentilles, oignon, ail et œufs battus, assaisonne, puis ajoute la farine petit à petit jusqu'à une pâte homogène.",
      "duree_min": 4,
      "actif": true
    },
    {
      "texte": "Fais dorer des galettes dans une poêle huilée, en plusieurs fois (12 galettes).",
      "duree_min": 15,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 300
    },
    {
      "texte": "Mélange concombre, yaourt et menthe, assaisonne de sel, poivre et cumin, et sers frais avec les galettes.",
      "duree_min": 3,
      "actif": true
    }
  ],
