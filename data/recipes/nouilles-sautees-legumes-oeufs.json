  "etapes": [
    {
      "texte": "Taille carottes et poireaux en julienne, détaille le brocoli en fleurettes, cisèle l'oignon, presse l'ail, râpe le gingembre, prélève le zeste du citron vert et concasse les cacahuètes.",
      "duree_min": 15,
      "actif": true
    },
    {
      "texte": "Dans une sauteuse avec un filet d'huile de sésame, fais dorer oignon, ail, gingembre et zeste 2 minutes, puis ajoute les légumes et fais-les sauter 5 minutes à feu vif.",
      "duree_min": 7,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 420
    },
    {
      "texte": "Cuis les nouilles selon le paquet. Pendant ce temps, brouille les œufs dans une autre poêle huilée.",
      "duree_min": 6,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 360
    },
    {
      "texte": "Réunis œufs et légumes, ajoute les nouilles et un filet de sauce soja, mélange et parsème de cacahuètes. Sers avec le citron vert.",
      "duree_min": 3,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 120
    }
  ],
