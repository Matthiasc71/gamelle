  "etapes": [
    {
      "texte": "Lance le riz au rice cooker avec la quantité d'eau indiquée sur le paquet : il cuit seul pendant la suite.",
      "duree_min": 25,
      "actif": false,
      "equipement": "rice-cooker",
      "en_fond": true
    },
    {
      "texte": "Taille le poivron en lanières, hache finement l'oignon et l'ail. Rince haricots et maïs.",
      "duree_min": 10,
      "actif": true
    },
    {
      "texte": "Dans une cocotte avec un filet d'huile, fais revenir oignon et ail, puis dore la viande et le poivron quelques minutes.",
      "duree_min": 8,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 480
    },
    {
      "texte": "Ajoute tout le reste (sauf le riz) avec un verre d'eau. Couvre et laisse mijoter 1 heure à feu doux en remuant de temps en temps.",
      "duree_min": 60,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 3600
    }
