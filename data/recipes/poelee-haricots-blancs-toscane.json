  "etapes": [
    {
      "texte": "Cisèle l'oignon, presse l'ail, coupe le pak choï en tronçons (feuilles hachées), les tomates en dés et les tomates séchées en morceaux. Rince et égoutte les haricots.",
      "duree_min": 10,
      "actif": true
    },
    {
      "texte": "Chauffe 2 c. à soupe d'huile des tomates séchées dans une sauteuse, ajoute pak choï, oignon, ail et tomates séchées et laisse cuire 5 minutes en remuant.",
      "duree_min": 5,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 300
    },
    {
      "texte": "Ajoute les dés de tomate et les haricots et laisse cuire encore 15 minutes en remuant.",
      "duree_min": 15,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 900
    },
    {
      "texte": "Ajoute le parmesan, mélange et laisse fondre 2 minutes.",
      "duree_min": 2,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 120
    }
