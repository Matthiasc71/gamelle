  "etapes": [
    {
      "texte": "Préchauffe le four à 180 °C. Coupe les champignons en quatre, l'oignon en fines tranches, cisèle l'échalote et presse l'ail.",
      "duree_min": 8,
      "actif": true
    },
    {
      "texte": "Mélange la viande, la chapelure, l'échalote, l'ail, l'œuf et les herbes, sale et poivre bien, puis forme des boulettes d'environ 30 g.",
      "duree_min": 10,
      "actif": true
    },
    {
      "texte": "Mélange sauce barbecue, sirop d'érable et moutarde, roules-y les boulettes et pose-les sur une plaque avec les légumes autour. Arrose d'un filet d'huile.",
      "duree_min": 4,
      "actif": true
    },
    {
      "texte": "Enfourne 20 à 25 minutes.",
      "duree_min": 23,
