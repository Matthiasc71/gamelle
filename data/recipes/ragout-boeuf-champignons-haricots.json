  "etapes": [
    {
      "texte": "Émince oignon et ail, coupe le poireau en rondelles, le céleri en dés et les champignons en quartiers. Rince les haricots.",
      "duree_min": 15,
      "actif": true
    },
    {
      "texte": "Dans une cocotte avec un filet d'huile, dore l'oignon et l'ail, puis ajoute le poireau et la viande 5 minutes.",
      "duree_min": 8,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 480
    },
    {
      "texte": "Ajoute champignons, céleri, vin, tomates, cube émietté, épices, sauce soja et 30 cl d'eau. Couvre et laisse mijoter 30 minutes à feu doux.",
      "duree_min": 30,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 1800
    },
    {
      "texte": "Lance le riz au rice cooker pendant le mijotage.",
      "duree_min": 2,
      "actif": true,
      "equipement": "rice-cooker"
    },
    {
      "texte": "Ajoute les haricots blancs et prolonge 15 minutes à couvert.",
      "duree_min": 15,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 900
    }
  ],
