  "etapes": [
    {
      "texte": "Coupe le poulet en cubes et fais-le mariner avec le jus de citron vert, l'huile de sésame et la sauce soja.",
      "duree_min": 4,
      "actif": true
    },
    {
      "texte": "Émince l'oignon, coupe la carotte en bâtonnets et sépare le brocoli en fleurettes.",
      "duree_min": 4,
      "actif": true
    },
    {
      "texte": "Cuis les nouilles selon le paquet, égoutte et rince-les.",
      "duree_min": 5,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 300
    },
    {
      "texte": "Dans un wok huilé, fais revenir l'oignon, puis le poulet avec sa marinade jusqu'à ce qu'il soit cuit. Ajoute carotte et brocoli 1 minute, puis le curry 2 minutes.",
      "duree_min": 9,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 540
    },
    {
      "texte": "Verse le lait de coco et 30 cl d'eau, ajoute les nouilles, mélange et sers bien chaud.",
      "duree_min": 2,
      "actif": true,
      "equipement": "plaques"
    }
  ],
