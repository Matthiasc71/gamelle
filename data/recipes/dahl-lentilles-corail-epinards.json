  "etapes": [
    {
      "texte": "Rince les lentilles. Émince les oignons, presse l'ail et râpe le gingembre.",
      "duree_min": 8,
      "actif": true
    },
    {
      "texte": "Dans une grande sauteuse huilée, fais fondre les oignons 5 minutes, puis ajoute ail, gingembre et épices 1 minute.",
      "duree_min": 6,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 360
    },
    {
      "texte": "Ajoute lentilles, tomates, lait de coco et bouillon. Laisse mijoter 20 minutes en remuant de temps en temps.",
      "duree_min": 20,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 1200
    },
    {
      "texte": "Hors du feu, ajoute les épinards et le jus de citron, mélange jusqu'à ce qu'ils tombent.",
      "duree_min": 2,
      "actif": true
    }
  ],
