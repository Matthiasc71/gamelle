  "etapes": [
    {
      "texte": "Émince les oignons, presse l'ail et coupe le filet mignon en lanières.",
      "duree_min": 8,
      "actif": true
    },
    {
      "texte": "Dans une cocotte avec l'huile de sésame, saisis la viande sur toutes les faces, sale, poivre et réserve.",
      "duree_min": 6,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 360
    },
    {
      "texte": "Fais revenir oignons et ail 2 minutes, puis ajoute le cube émietté, le balsamique, la sauce soja, le miel et le gingembre.",
      "duree_min": 4,
      "actif": true,
      "equipement": "plaques"
    },
    {
      "texte": "Remets la viande, couvre d'eau à hauteur et laisse mijoter 25 minutes à couvert. Lance le riz au rice cooker.",
      "duree_min": 25,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 1500
    },
    {
      "texte": "Retire le couvercle et laisse réduire 5 minutes, jusqu'à ce que la sauce nappe.",
      "duree_min": 5,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 300
    }
