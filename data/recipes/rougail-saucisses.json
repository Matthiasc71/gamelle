  "etapes": [
    {
      "texte": "Cisèle les oignons, presse l'ail et râpe le gingembre.",
      "duree_min": 6,
      "actif": true
    },
    {
      "texte": "Pique les saucisses et cuis-les 10 minutes à l'eau bouillante, puis coupe-les en rondelles.",
      "duree_min": 11,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 600
    },
    {
      "texte": "Fais dorer les rondelles 5 minutes dans une sauteuse et réserve-les. À leur place, fais revenir oignons, ail et gingembre quelques minutes.",
