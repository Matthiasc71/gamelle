  "etapes": [
    {
      "texte": "Épluche les pommes de terre et cuis-les une vingtaine de minutes à l'eau bouillante salée : tendres, mais encore fermes. Sors-les à l'écumoire.",
      "duree_min": 22,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 1200
    },
    {
      "texte": "Dans la même eau, cuis les fleurettes de brocoli 10 minutes, puis égoutte. Préchauffe le four à 180 °C.",
      "duree_min": 10,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 600
    },
    {
      "texte": "Coupe le chorizo en demi-rondelles et les pommes de terre en rondelles. Range le tout avec le brocoli dans un plat, sale, poivre et arrose de crème.",
      "duree_min": 5,
      "actif": true
    },
    {
      "texte": "Parsème de parmesan et enfourne 15 minutes.",
