  "etapes": [
    {
      "texte": "Cuis les lentilles 20 à 25 minutes à l'eau non salée et égoutte. Pendant ce temps, coupe les carottes en dés, cisèle les oignons et presse l'ail.",
      "duree_min": 25,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 1350
    },
    {
      "texte": "Cuis les patates douces en cubes 15 à 20 minutes à l'eau, écrase-les et ajoute l'œuf, 3 c. à soupe de crème, sel et poivre. Préchauffe le four à 180 °C.",
      "duree_min": 20,
      "actif": false,
      "equipement": "plaques",
      "minuteur_s": 1080
    },
    {
      "texte": "Dans une sauteuse huilée, fais revenir oignons et ail, ajoute carottes et poivrons, laisse cuire 10 minutes, puis ajoute les lentilles et la farine.",
      "duree_min": 12,
      "actif": true,
      "equipement": "plaques",
      "minuteur_s": 600
    },
    {
      "texte": "Verse les lentilles dans un plat, arrose du reste de crème, couvre de purée et de fromage râpé, et enfourne 20 minutes.",
      "duree_min": 22,
      "actif": false,
      "equipement": "four",
      "minuteur_s": 1200
    }
  ],
